{
  "id": "s1-is-not-null",
  "rule": "S1",
  "query": {
    "source": "orders",
    "select": [
      "id"
    ],
    "filter": {
      "and": [
        {
          "field": "id",
          "op": "in",
          "value": [
            1,
            2,
            3
          ]
        },
        {
          "field": "amount",
          "op": "is_not_null"
        }
      ]
    },
    "sort": [
      {
        "field": "id"
      }
    ]
  },
  "expected": {
    "columns": [
      "id"
    ],
    "rows": [
      [
        1
      ],
      [
        2
      ]
    ]
  },
  "ordered": true
}
