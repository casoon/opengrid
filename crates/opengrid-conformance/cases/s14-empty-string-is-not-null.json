  "query": {
    "source": "orders",
    "select": [
      "id"
    ],
    "filter": {
      "and": [
        {
          "field": "id",
          "op": "in",
          "value": [
            1,
            2
          ]
        },
        {
          "field": "note",
          "op": "is_null"
        }
      ]
    }
  },
  "expected": {
    "columns": [
      "id"
    ],
    "rows": [
      [
        1
      ]
    ]
  },
  "ordered": false
}
