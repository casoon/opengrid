{
  "id": "s8-integer-literal-on-decimal",
  "rule": "S8",
  "query": {
    "source": "orders",
    "select": [
      "id",
      "amount"
    ],
    "filter": {
      "field": "amount",
      "op": "gt",
      "value": 50
    }
  },
  "expected": {
    "columns": [
      "id",
      "amount"
    ],
    "rows": [
      [
        4,
        "100.00"
      ],
      [
        7,
        "999999999.99"
      ],
      [
        50,
        "50.50"
      ]
    ]
  },
  "ordered": false
}
