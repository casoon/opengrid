          "op": "lte",
          "value": "2026-01-01"
        }
      ]
    },
    "sort": [
      {
        "field": "id"
      }
    ]
  },
  "expected": {
    "columns": [
      "id",
      "ordered_on"
    ],
    "rows": [
      [
        2,
        "2026-01-01"
      ],
      [
        3,
        "2026-01-01"
      ]
    ]
  },
  "ordered": true
}
