      "value": [
        3,
        4
      ]
    },
    "sort": [
      {
        "field": "id"
      }
    ]
  },
  "expected": {
    "columns": [
      "id",
      "tags",
      "rooms"
    ],
    "rows": [
      [
        3,
        [],
        [
          101
        ]
      ],
      [
        4,
        null,
        null
      ]
    ]
  },
  "ordered": true
}
