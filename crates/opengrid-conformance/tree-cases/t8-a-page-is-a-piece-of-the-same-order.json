  "expected": {
    "columns": ["id", "name"],
    "rows": [[1, "Sales"], [2, "North"], [4, "Alice"]],
    "total_count": 10,
    "tree": {
      "children": [2, 2, 1],
      "match": [true, true, true],
      "matches": 10,
      "orphans": 1,
      "flat": {
        "level": [1, 2, 3],
        "path": [[1], [1, 2], [1, 2, 4]],
        "filtered": false
      }
    }
  }
