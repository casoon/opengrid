{
  // The adapter's types in use (#510): src/types.tsx takes what the components
  // take and holds what they refuse. `just types` runs it; the example itself
  // is plain JSX and not type-checked.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "files": ["src/types.tsx"]
}
