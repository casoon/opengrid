{
  "name": "@casoon/opengrid",
  "version": "0.1.0",
  "type": "module",
  "description": "Accessible data grid, table and pivot as web components, driven by a portable Rust/WASM query engine.",
  "keywords": [
    "datagrid",
    "pivot",
    "web-components",
    "accessibility",
    "wasm"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casoon/opengrid.git"
  },
  "homepage": "https://github.com/casoon/opengrid#readme",
  "bugs": {
    "url": "https://github.com/casoon/opengrid/issues"
  },
  "exports": {
    ".": {
      "types": "./loader.d.ts",
      "default": "./loader.js"
    },
    "./loader.js": {
      "types": "./loader.d.ts",
      "default": "./loader.js"
    },
    "./worker.js": "./worker.js",
    "./pkg/*": "./pkg/*",
    "./package.json": "./package.json"
  },
  "main": "./loader.js",
  "types": "./loader.d.ts",
  "sideEffects": [
    "./worker.js"
  ],
  "files": [
    "loader.js",
    "loader.d.ts",
    "worker.js",
    "pkg/",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
