{
  "name": "@casoon/opengrid",
  "version": "0.16.0",
  "type": "module",
  "description": "Accessible data grid, table and pivot as web components, driven by a portable Rust/WASM query engine — with React, Vue and Svelte components.",
  "keywords": [
    "datagrid",
    "pivot",
    "web-components",
    "accessibility",
    "wasm",
    "react",
    "vue",
    "svelte"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casoon/opengrid.git"
  },
  "homepage": "https://github.com/casoon/opengrid#readme",
  "bugs": {
    "url": "https://github.com/casoon/opengrid/issues"
  },
  "exports": {
    ".": {
      "types": "./loader.d.ts",
      "default": "./loader.js"
    },
    "./loader.js": {
      "types": "./loader.d.ts",
      "default": "./loader.js"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./vue": {
      "types": "./vue/index.d.ts",
      "default": "./vue/index.js"
    },
    "./svelte": {
      "types": "./svelte/index.d.ts",
      "svelte": "./svelte/index.js",
      "default": "./svelte/index.js"
    },
    "./texts/de": {
      "types": "./texts/de.d.ts",
      "default": "./texts/de.js"
    },
    "./worker.js": "./worker.js",
    "./pkg/*": "./pkg/*",
    "./engine/*": "./engine/*",
    "./xlsx/*": "./xlsx/*",
    "./package.json": "./package.json"
  },
  "main": "./loader.js",
  "types": "./loader.d.ts",
  "sideEffects": [
    "./worker.js"
  ],
  "files": [
    "loader.js",
    "loader.d.ts",
    "worker.js",
    "react/",
    "vue/",
    "svelte/",
    "texts/",
    "pkg/",
    "engine/",
    "xlsx/",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@types/react": ">=18.3.0",
    "react": ">=18",
    "svelte": "^5.0.0",
    "vue": ">=3.4.20"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "svelte": "5.57.3",
    "vue": "3.5.45"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
