---
import { Demo } from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';

// Built by `just wasm-build-components wasm-build`, copied by scripts/demo-assets.mjs.
const assets = url('opengrid/');
---

<Base
  title="Demo"
  description="opengrid running in the browser: the WASM engine answers queries from an <opengrid-grid> and an <opengrid-table>."
>
  <div class="page">
    <h1>Live demo</h1>
    <p class="lead">
      Both elements below run on the WebAssembly engine in this tab, over the 50-row dataset the
      conformance suite is written against (<code>crates/opengrid-conformance/data/orders.csv</code>).
      Nothing is sent to a server. The pivot needs an <code>opengrid-server</code> and is not part of
      this page.
    </p>

    <Demo
      title="<opengrid-grid>"
      lead="Interactive: arrow keys move between cells, Enter or Space on a header sorts (Shift adds a second key), Space selects a row, Enter on a cell opens the editor. The filter row applies on Enter. Unstyled on purpose: system form controls and system colors, so it drops into any page without fighting existing styles."
    >
      <div class="og-demo" data-assets={assets}>
        <opengrid-grid
          label="Orders"
          datasource="orders"
          columns="id,customer,country,amount,qty,ordered_on"
          window-size="40"></opengrid-grid>
      </div>
    </Demo>

    <Demo
      title="<opengrid-grid> — themed"
      lead="Same element, same data, only CSS added. The look comes entirely from the documented ::part() selectors and custom properties (docs/api.md) — filter-operator, filter-value, filter-clear, header, row, cell, status and the pager parts — nothing here required a change to the component."
    >
      <div class="og-demo og-demo--themed">
        <opengrid-grid
          label="Orders"
          datasource="orders"
          columns="id,customer,country,amount,qty,ordered_on"
          window-size="40"></opengrid-grid>
      </div>
    </Demo>

    <Demo
      title="<opengrid-table>"
      lead="Display: a plain native table with header buttons that sort one column."
    >
      <div class="og-demo">
        <opengrid-table label="Orders by customer" datasource="orders" columns="id,customer,country,amount"
        ></opengrid-table>
      </div>
      <script is:inline type="module">
        const base = document.querySelector('[data-assets]').dataset.assets;
        const { loadOpengrid, createLocalProvider } = await import(`${base}loader.js`);
        const { default: init, Engine } = await import(`${base}engine/opengrid_wasm.js`);

        await init();
        const engine = new Engine();
        const schema = await (await fetch(`${base}data/orders.schema.json`)).text();
        const csv = await (await fetch(`${base}data/orders.csv`)).arrayBuffer();
        engine.load_csv('orders', new Uint8Array(csv), schema);

        const loader = await loadOpengrid();
        for (const host of document.querySelectorAll('opengrid-grid, opengrid-table')) {
          loader.module.set_provider(host, createLocalProvider(engine));
        }
      </script>
    </Demo>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: 32px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 56px 24px 72px;
  }
  h1 {
    margin: 0;
    color: var(--heading);
  }
  .lead {
    max-width: 70ch;
    margin: 0;
  }
  .og-demo {
    color: var(--text);
  }
  .og-demo opengrid-grid {
    display: block;
    /* A definite height makes the grid's viewport the scroll container, so it virtualizes. */
    height: 420px;
    overflow: hidden;
    --og-line: var(--border);
  }

  /* Themed variant: only ::part() selectors and the documented custom properties —
     the same public surface any consumer has (docs/api.md). */
  .og-demo--themed opengrid-grid {
    --og-focus-width: 2px;
    border-radius: 12px;
    box-shadow: var(--shadow);
  }
  .og-demo--themed opengrid-grid::part(layout) {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
  }
  .og-demo--themed opengrid-grid::part(filter) {
    background: var(--bg-deep);
    padding: 0.5rem 0.75rem;
  }
  .og-demo--themed opengrid-grid::part(filter-operator),
  .og-demo--themed opengrid-grid::part(filter-value) {
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--surface);
    color: var(--text);
    padding: 0.3rem 0.5rem;
    font-size: 0.85rem;
  }
  .og-demo--themed opengrid-grid::part(filter-value) {
    width: 6.5rem;
  }
  .og-demo--themed opengrid-grid::part(filter-operator):focus-visible,
  .og-demo--themed opengrid-grid::part(filter-value):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .og-demo--themed opengrid-grid::part(filter-clear) {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
  }
  .og-demo--themed opengrid-grid::part(filter-clear):hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .og-demo--themed opengrid-grid::part(status) {
    color: var(--muted);
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
  }
  .og-demo--themed opengrid-grid::part(header) {
    background: var(--bg-deep);
    color: var(--heading);
    font-weight: 600;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .og-demo--themed opengrid-grid::part(sort-direction),
  .og-demo--themed opengrid-grid::part(sort-index) {
    color: var(--accent);
  }
  .og-demo--themed opengrid-grid::part(row) {
    background: var(--surface);
  }
  .og-demo--themed opengrid-grid::part(row):nth-of-type(even) {
    background: var(--bg-deep);
  }
  .og-demo--themed opengrid-grid::part(cell) {
    color: var(--text);
    font-size: 0.875rem;
  }
  .og-demo--themed opengrid-grid::part(pager) {
    padding: 0.4rem 0.75rem;
  }
  .og-demo--themed opengrid-grid::part(page-first),
  .og-demo--themed opengrid-grid::part(page-previous),
  .og-demo--themed opengrid-grid::part(page-next),
  .og-demo--themed opengrid-grid::part(page-last) {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    padding: 0.25rem 0.6rem;
    font-size: 0.8rem;
  }
  .og-demo--themed opengrid-grid::part(page-label) {
    color: var(--muted);
    font-size: 0.8rem;
  }
</style>
