---
import {
  Badge,
  Badges,
  Button,
  CallToAction,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
  Spotlight,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { url } from '@casoon/pages-theme/url';
import Diagram from '../components/Diagram.astro';
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { brotliCompressSync, constants } from 'node:zlib';

// Figures that cannot go stale: counted from the repository, measured from the modules the
// demo ships (`scripts/demo-assets.mjs` copies them into public/opengrid/ before the build).
const caseDirs = import.meta.glob('../../../crates/opengrid-conformance/*cases/*.json');
const specs = import.meta.glob<string>('../../../tests/e2e/*.spec.js', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const conformanceCases = Object.keys(caseDirs).length;
const axeSpecs = Object.values(specs).filter((source) => source.includes('@axe-core/playwright')).length;

/** The size of a shipped module, brotli at quality 11 like `just measure-modules`; `null` when it is not there. */
function brotliKiB(file: string): number | null {
  const path = resolve(process.cwd(), 'public/opengrid', file);
  if (!existsSync(path)) return null;
  const packed = brotliCompressSync(readFileSync(path), {
    params: { [constants.BROTLI_PARAM_QUALITY]: 11 },
  });
  return Math.round(packed.length / 1024);
}
const engineKiB = brotliKiB('engine/opengrid_wasm_bg.wasm');
const elementsKiB = brotliKiB('pkg/opengrid_web_components_bg.wasm');

// From README.md ("Data from a server"): a grid whose queries an opengrid-server answers.
const page = `<opengrid-grid label="Orders" datasource="orders"
               columns="id,customer,amount"></opengrid-grid>
<script type="module">
  import { connect, createRestProvider } from "@casoon/opengrid";
  connect(document.querySelector("opengrid-grid"), {
    provider: createRestProvider({ url: "https://example.org", source: "orders", token: "…" }),
  });
</script>`;
---

<Base>
  <Hero
    title="Grid, table and pivot on one query engine."
    lead="opengrid gives your web page three Web Components for showing and working with tabular data: a data grid, a table and a pivot. Sorting, filtering, grouping and pivots are answered by one engine: in the browser as WebAssembly, on your server against PostgreSQL, or split between the two, and the answer is the same everywhere."
  >
    <Install
      commands={[
        { label: 'npm', command: 'npm install @casoon/opengrid' },
        { label: 'pnpm', command: 'pnpm add @casoon/opengrid' },
      ]}
    />
    <Badges>
      <Badge>MIT OR Apache-2.0</Badge>
      <Badge>npm {config.version}</Badge>
      <Badge>React · Vue · Svelte · plain HTML</Badge>
    </Badges>
    {/* Captured from the live demo og-vanilla.casoon.dev/overview at about the width shown here
        (2x pixel density), so the text keeps its size; on phones a narrower capture of the same
        grid with the demo's selection column switched off. */}
    <picture slot="output">
      <source
        media="(max-width: 640px)"
        srcset={url('screens/grid-overview-narrow.webp')}
        width="764"
        height="870"
      />
      <img
        class="screenshot"
        src={url('screens/grid-overview.webp')}
        width="1084"
        height="870"
        alt="opengrid-grid in the Base look, from the live demo: a search field with + Filter, + Group, Filter row, Columns and the density switch, a filter row, and the first orders sorted by ID with order date and customer, such as 1, 12 Apr 2026, Yarrow Works."
      />
    </picture>
  </Hero>

  <Spotlight
    eyebrow="Why WebAssembly"
    title="The engine is Rust, compiled to WebAssembly."
    lead="Sorting, filtering and grouping live in one engine, not in the component. It runs next to your page, in a worker if you like, and the same code answers on your server, so the tab and the server give the same answer without a second implementation."
    points={[
      '**Fast where it counts.** On 100,000 rows a filter takes 1.4 ms, a sort 5 ms and a group-by 9 ms; on a million rows, 14, 52 and 96 ms.',
      '**Light on memory.** The columns take 9.8 MiB for 100,000 rows and 98 MiB for a million; the module\'s memory, loading included, is 23.6 and 213 MiB. 64-bit integers, exact decimals and microsecond timestamps stay what they are.',
      '**Off the main thread.** In a worker the page stays usable while the engine works; the live demo queries 100,000 rows that way.',
      engineKiB && elementsKiB
        ? `**What it costs.** A module the page loads: the engine is ${engineKiB} KiB and all three elements together ${elementsKiB} KiB, brotli-compressed. Fifty rows do not need it.`
        : '**What it costs.** A module the page loads, a few hundred kilobytes. Fifty rows do not need it.',
    ]}
    links={[
      { label: 'What the engine costs, measured', href: url('docs/guides/performance/') },
      { label: 'The 100,000-row demo', href: 'https://og-vanilla.casoon.dev/large-data' },
    ]}
  >
    <Facts
      layout="list"
      label="Measured: the engine on 100,000 and 1,000,000 rows"
      items={[
        { label: 'Filter, 100,000 rows', value: '1.4\u00a0ms' },
        { label: 'Sort, top 100, 100,000 rows', value: '4.8\u00a0ms' },
        { label: 'Group by country, 100,000 rows', value: '9\u00a0ms' },
        { label: 'Filter, 1,000,000 rows', value: '14\u00a0ms' },
        { label: 'Sort, top 100, 1,000,000 rows', value: '52\u00a0ms' },
        { label: 'Module memory, 100,000 rows', value: '23.6\u00a0MiB' },
        { label: 'Module memory, 1,000,000 rows', value: '213\u00a0MiB' },
      ]}
    />
    <p class="measured">
      Apple M4 Pro, the engine on its own, median of nine runs, 14 November 2026.{' '}
      <a href={url('docs/guides/performance/')}>Method, all figures and the script to repeat it.</a>
    </p>
  </Spotlight>

  <Features
    heading="What sets it apart"
    items={[
      {
        title: 'One engine, everywhere',
        body: `The same Rust code answers in the tab, on your server against PostgreSQL or SQLite, or split by a planner. ${conformanceCases} case files pin the answers, text order included: name a locale and every path sorts alike.`,
      },
      {
        title: 'A table where a table is meant',
        body: `A native <table> for reading, role="grid" only where the reader works. Keyboard throughout, axe-core in ${axeSpecs} specs; what is verified and what is still open is written down.`,
      },
      {
        title: 'No SQL from the browser',
        body: 'A query is a JSON document, checked against the fields and rows the token may see. The server is a library in your own program, which decides who is let in.',
      },
      {
        title: 'Next to an AI assistant',
        body: 'In chat clients with MCP Apps the same grid opens beside the conversation. The reader keeps the keyboard, the assistant sets the view through tools, and fields you left out stay out of reach.',
      },
    ]}
  />

  <Features
    heading="Who it is for"
    items={[
      {
        title: 'Apps that live on tables',
        body: 'Admin areas, reporting, internal tools: sorting, filtering, grouping, editing, a pivot with subtotals, trees and export, all in one package under MIT or Apache-2.0.',
      },
      {
        title: 'Any front end',
        body: 'The elements are Web Components. React, Vue and Svelte get components from the same package; Angular, Astro and plain HTML use them directly.',
      },
      {
        title: 'Readers with a keyboard or a screen reader',
        body: 'A native table where reading is enough and a grid where interaction needs one, operated from the keyboard and tested with axe in every state.',
      },
      {
        title: 'Data too big for the browser',
        body: 'Keep the data on your server: the browser sends a query object, never SQL, and the server enforces tokens, a row filter per tenant and the fields a client may see.',
      },
    ]}
  />

  <Facts
    items={[
      { value: String(conformanceCases), label: 'conformance cases, each pinned to a numbered rule' },
      { value: String(axeSpecs), label: 'end-to-end specs that run axe-core' },
      { value: '3', label: 'places a query can run: tab, server, or both' },
      { value: '5', label: 'live demo sites: JavaScript, React, Vue, Svelte, Angular' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <div class="text">
      <p>
        An element never runs a query itself. It hands the query, as JSON, to a provider you
        choose. The engine can answer it right in the tab, compiled to WebAssembly and running in
        a worker if you like, so data the page loads itself needs no server at all.
      </p>
      <p>
        For data that belongs on a server, <code>opengrid-server</code> answers the same queries
        from PostgreSQL, SQLite or a connector of your own. In between, the planner gives the
        server the part it can answer and finishes the rest in the tab. A shared set of
        conformance cases checks that all paths agree.
      </p>
    </div>
    <Diagram name="where-queries-run" format="svg" narrow={{ width: 560, height: 720 }} />
    <div class="links">
      <Button href={url('docs/guides/where-queries-run/')} variant="secondary">Where queries run</Button>
      <Button href={url('docs/guides/query-semantics/')} variant="secondary">Query semantics</Button>
      <Button href={url('demo/')} variant="secondary">Try the demo</Button>
      <Button href="https://og-vanilla.casoon.dev/" variant="quiet">All live demos →</Button>
    </div>
  </section>

  <Quickstart
    lead="Install the package, put an element on the page and connect it to a provider. The documentation walks through the engine in the tab, bundlers and the React, Vue and Svelte components."
    steps={[
      'Install <code>@casoon/opengrid</code> with the line above.',
      'Put an <code>&lt;opengrid-table&gt;</code>, <code>&lt;opengrid-grid&gt;</code> or <code>&lt;opengrid-pivot&gt;</code> on the page.',
      'Connect it to a provider: the engine in the tab, or your server as below.',
    ]}
  >
    <CodeBlock code={page} lang="html" title="index.html" label="HTML" />
  </Quickstart>

  <CallToAction
    title="A grid on your page in three steps."
    href={url('docs/getting-started/quickstart/')}
    label="Read the quickstart"
  />
</Base>

<style>
  .screenshot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  /* The note under the measured figures: small, quiet, and on the 8 px grid. */
  .measured {
    margin: 16px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .measured a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
</style>
