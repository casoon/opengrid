---
import {
  Badge,
  Badges,
  CallToAction,
  CodeBlock,
  Features,
  Hero,
  Install,
  Quickstart,
  Section,
  SectionIntro,
  Tradeoffs,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import FrameworkDemos from '../components/FrameworkDemos.astro';
import config from 'virtual:casoon-pages/config';
import { url } from '@casoon/pages-theme/url';

// From README.md ("Data in the browser"): rows the page already holds become a grid in one call.
const page = `<opengrid-grid label="Orders"></opengrid-grid>

<script type="module">
  import { fromRows } from "@casoon/opengrid";
  const rows = [
    { id: 1, customer: "Ada", amount: 120 },
    { id: 2, customer: "Grace", amount: 80 },
  ];
  await fromRows(document.querySelector("opengrid-grid"), rows);
</script>`;
---

<Base>
  <Hero
    layout="editorial"
    bleed
    title="A grid, a table and a pivot, added with one element."
    lead="opengrid is a free data grid, table and pivot for the web. Put an element on the page and hand it your rows: sorting, filtering, grouping, editing and export already work. The engine behind it is WebAssembly. It answers in the browser, or on your server when the data is too big for the tab."
  >
    <Install
      commands={[
        { label: 'npm', command: 'npm install @casoon/opengrid' },
        { label: 'pnpm', command: 'pnpm add @casoon/opengrid' },
      ]}
    />
    <Badges>
      <Badge>MIT OR Apache-2.0</Badge>
      <Badge>npm {config.version}</Badge>
      <Badge>React · Vue · Svelte · Solid · plain HTML</Badge>
    </Badges>
    {/* Captured from the live demo og-vanilla.casoon.dev/overview, light look, 2x pixel density,
        with the demo's selection column and the Category column switched off so the other eight
        columns fit; on phones a narrower capture of the same grid. */}
    <picture slot="output">
      <source
        media="(max-width: 640px)"
        srcset={url('screens/grid-overview-narrow.webp')}
        width="764"
        height="870"
      />
      <img
        style="height: auto"
        src={url('screens/grid-overview-wide.webp')}
        width="2320"
        height="1033"
        alt="opengrid-grid in the Base look, from the live demo: a search field with + Filter, + Group, Filter row, Columns and the density switch, a filter row, and the first orders sorted by ID with the columns order date, customer, country, product, quantity, amount and status, such as 1, 12 Apr 2026, Yarrow Works, CH, On-site Setup, 2, €500.00, Delivered."
      />
    </picture>
  </Hero>

  <SectionIntro
    title="What opengrid is for"
    lead="A grid you do not have to build. A page that shows tables should get sorting, filtering, grouping, editing and export without writing them, and without paying for them. That is the aim: **simple to use, work taken off you, free to use**."
  />

  <Features
    heading="Three promises"
    size="sub"
    items={[
      {
        title: 'Simple to use',
        body: 'One element and your rows. `fromRows` reads the types from the rows. Search, sort, filter, group, select and edit are built in, and everything can be reached from the keyboard.',
      },
      {
        title: 'It takes the work off you',
        body: 'One engine answers every question: sorting, filtering, grouping, pivots with subtotals. It runs as WebAssembly in the tab, or on your server for data that does not fit. You write no paging, sorting or export code.',
      },
      {
        title: 'Free',
        body: 'MIT OR Apache-2.0. No licence key, no account, no paid edition: pivot, grouping, tree and export are in the one package.',
      },
    ]}
  />

  <Section
    title="Try it in your framework"
    lead="The same demos, once per framework, each a small app you can read."
  >
    <FrameworkDemos />
  </Section>

  <Features
    heading="What it can do"
    layout="grid"
    items={[
      { icon: 'grid', title: 'Data grid', body: 'Sorting, filtering, search, facets, grouping with totals, selection and editing; virtualised or paged.' },
      { icon: 'table', title: 'Table', body: 'A plain semantic `<table>` for data that is read, not worked with.' },
      { icon: 'pivot', title: 'Pivot', body: 'Rows crossed with columns, with subtotals and a grand total.' },
      { icon: 'wasm', title: 'One engine', body: 'The same query and the same answer in the browser, on a server and against PostgreSQL.' },
      { icon: 'csv', title: 'Export', body: 'What the reader sees, every match of it, as CSV or JSON; XLSX from the server.' },
      { icon: 'look', title: 'Looks and languages', body: 'Five built-in looks, your own colours on top, and column titles in your language.' },
    ]}
  />

  <Quickstart
    lead="Install the package, put an element on the page, hand it your rows. For bigger data, connect it to the engine in the tab or to your server; the documentation shows both."
    steps={[
      'Install <code>@casoon/opengrid</code> with the line above.',
      'Put an <code>&lt;opengrid-grid&gt;</code> on the page. For a read-only list use <code>&lt;opengrid-table&gt;</code>, for crosstabs <code>&lt;opengrid-pivot&gt;</code>.',
      'Hand it your rows with <code>fromRows</code>.',
    ]}
  >
    <CodeBlock code={page} lang="html" title="index.html" label="HTML" />
  </Quickstart>

  <Tradeoffs
    eyebrow="The price"
    title="What you give up"
    lead="Read this before you choose it."
    items={[
      'The engine is a WebAssembly module the page has to load. A table of fifty rows does not need it.',
      'There is no expression language: a column is stored or derived from a date part, never calculated in the grid.',
      'A pivot has hard limits and answers with an error over them, never with a truncated result.',
      'It is pre-1.0. The API is written down and tested, and may still change.',
    ]}
  />

  <CallToAction
    title="See it running before you install it."
    href="https://og-vanilla.casoon.dev/overview"
    label="Open the live demo"
  />
</Base>

<style>
  .screenshot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
</style>
