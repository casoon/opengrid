---
import {
  AudienceList,
  Badge,
  Badges,
  BarCompare,
  Button,
  CallToAction,
  CodeBlock,
  Compare,
  ElementList,
  Facts,
  FlowPanel,
  Hero,
  Install,
  Quickstart,
  SectionIntro,
  Showcase,
  Split,
  StatBand,
  Tradeoffs,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { url } from '@casoon/pages-theme/url';
import Diagram from '../components/Diagram.astro';
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { brotliCompressSync, constants } from 'node:zlib';

// Figures that cannot go stale: counted from the repository, measured from the modules the
// demo ships (`scripts/demo-assets.mjs` copies them into public/opengrid/ before the build).
const caseDirs = import.meta.glob('../../../crates/opengrid-conformance/*cases/*.json');
const specs = import.meta.glob<string>('../../../tests/e2e/*.spec.js', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const conformanceCases = Object.keys(caseDirs).length;
const axeSpecs = Object.values(specs).filter((source) => source.includes('@axe-core/playwright')).length;

/** The size of a shipped module, brotli at quality 11 like `just measure-modules`; `null` when it is not there. */
function brotliKiB(file: string): number | null {
  const path = resolve(process.cwd(), 'public/opengrid', file);
  if (!existsSync(path)) return null;
  const packed = brotliCompressSync(readFileSync(path), {
    params: { [constants.BROTLI_PARAM_QUALITY]: 11 },
  });
  return Math.round(packed.length / 1024);
}
const engineKiB = brotliKiB('engine/opengrid_wasm_bg.wasm');
const elementsKiB = brotliKiB('pkg/opengrid_web_components_bg.wasm');

// From README.md ("Data from a server"): a grid whose queries an opengrid-server answers.
const page = `<opengrid-grid label="Orders" datasource="orders"
               columns="id,customer,amount"></opengrid-grid>
<script type="module">
  import { connect, createRestProvider } from "@casoon/opengrid";
  connect(document.querySelector("opengrid-grid"), {
    provider: createRestProvider({ url: "https://example.org", source: "orders", token: "…" }),
  });
</script>`;

// From docs/protocol.md: a query is a JSON document with a fixed shape.
const query = `{
  "source": "orders",
  "select": ["id", "customer", "amount"],
  "filter": { "and": [
    { "field": "country", "op": "eq", "value": "DE" },
    { "field": "amount", "op": "gte", "value": "10.00" }
  ] },
  "sort": [{ "field": "id", "direction": "asc", "nulls": "last" }],
  "offset": 0,
  "limit": 50
}`;

// What a grid in server mode sends for one window (docs/protocol.md, "The query object").
const windowQuery = `{
  "source": "orders",
  "select": ["id", "customer", "country", "amount"],
  "filter": { "and": [
    { "field": "country", "op": "eq", "value": "DE" },
    { "field": "amount", "op": "gte", "value": "500.00" }
  ] },
  "sort": [{ "field": "amount", "direction": "desc" }],
  "offset": 500000,
  "limit": 40
}`;
---

<Base>
  <Hero
    title="Grid, table and pivot on one query engine."
    lead="opengrid gives your web page three Web Components for showing and working with tabular data: a data grid, a table and a pivot. Sorting, filtering, grouping and pivots are answered by one engine: in the browser as WebAssembly, on your server against PostgreSQL, or split between the two, and the answer is the same everywhere."
  >
    <Install
      commands={[
        { label: 'npm', command: 'npm install @casoon/opengrid' },
        { label: 'pnpm', command: 'pnpm add @casoon/opengrid' },
      ]}
    />
    <Badges>
      <Badge>MIT OR Apache-2.0</Badge>
      <Badge>npm {config.version}</Badge>
      <Badge>React · Vue · Svelte · plain HTML</Badge>
    </Badges>
    {/* Captured from the live demo og-vanilla.casoon.dev/overview at about the width shown here
        (2x pixel density), so the text keeps its size; on phones a narrower capture of the same
        grid with the demo's selection column switched off. */}
    <picture slot="output">
      <source
        media="(max-width: 640px)"
        srcset={url('screens/grid-overview-narrow.webp')}
        width="764"
        height="870"
      />
      <img
        class="screenshot"
        src={url('screens/grid-overview.webp')}
        width="1084"
        height="870"
        alt="opengrid-grid in the Base look, from the live demo: a search field with + Filter, + Group, Filter row, Columns and the density switch, a filter row, and the first orders sorted by ID with order date and customer, such as 1, 12 Apr 2026, Yarrow Works."
      />
    </picture>
  </Hero>

  <StatBand
    label="opengrid in numbers"
    items={[
      { value: String(conformanceCases), label: 'conformance cases, each pinned to a numbered rule' },
      { value: String(axeSpecs), label: 'end-to-end specs that run axe-core' },
      { value: '3', label: 'places a query can run: tab, server, or both' },
      { value: '5', label: 'live demo sites: JavaScript, React, Vue, Svelte, Angular' },
    ]}
  />

  <SectionIntro
    title="It is a query engine. The grid shows its answers."
    lead="Most data grids are a JavaScript component that draws rows and also sorts, filters and groups them. opengrid starts from the other end, and that one decision explains most of what follows."
  />

  <Split
    index="01"
    eyebrow="One engine, everywhere"
    title="The tab and the server give the same answer."
    lead="An element never runs a query itself. It hands the query, as JSON, to a provider you choose, and the same Rust code answers wherever the provider points. Moving a data set from the browser to a server is a change of provider, not a second implementation."
    note={'Name a locale and every path sorts alike: `"collation": "de"` gives one order from the engine, SQLite and PostgreSQL.'}
    links={[
      { label: 'Where queries run', href: url('docs/guides/where-queries-run/') },
      { label: 'Query semantics', href: url('docs/guides/query-semantics/') },
    ]}
  >
    <FlowPanel
      start={{ title: 'Grid, table or pivot', body: 'hands its query to a provider, as JSON' }}
      paths={[
        { label: 'Browser', title: 'In the tab', body: 'WebAssembly, in a worker if you like. No server needed.' },
        { label: 'Both', title: 'Hybrid', body: 'The planner sends the server what it can do and finishes the rest in the tab.' },
        { label: 'Your server', title: 'On the server', body: 'opengrid-server reads PostgreSQL, SQLite or a connector of your own.' },
      ]}
      result={`Every path has to pass the same ${conformanceCases} case files. One that disagrees fails its test.`}
    />
  </Split>

  <Split
    index="02"
    reverse
    eyebrow="Why WebAssembly"
    title="A million rows sorted in 26 ms, off the main thread."
    lead="Sorting, filtering and grouping live in an engine written in Rust, not in the component. It runs next to your page, in a worker if you like, so the page stays usable while it works."
    points={[
      '**Types the data needs.** 64-bit integers stay integers, decimals are exact, timestamps keep microseconds.',
      "**Compact, not free.** The engine keeps its own copy beside the page's data: the whole page holds about 145 to 175 MiB for a million rows, loaded from a fetched CSV.",
      engineKiB && elementsKiB
        ? `**A module the page loads.** The engine is ${engineKiB} KiB and all three elements together ${elementsKiB} KiB, brotli-compressed. Fifty rows do not need it.`
        : '**A module the page loads.** A few hundred kilobytes. Fifty rows do not need it.',
    ]}
    links={[
      { label: 'What the engine costs, measured', href: url('docs/guides/performance/') },
      { label: 'The 100,000-row demo', href: 'https://og-vanilla.casoon.dev/large-data' },
    ]}
  >
    <BarCompare
      title="Measured: the engine on its own"
      series={['100,000 rows', '1,000,000 rows']}
      rows={[
        { label: 'Filter', values: [1.6, 15], display: ['1.6 ms', '15 ms'] },
        { label: 'Sort, top 100', values: [3, 26], display: ['3 ms', '26 ms'] },
        { label: 'Group by country', values: [10, 99], display: ['10 ms', '99 ms'] },
      ]}
      facts={[
        { label: 'Load a CSV, 100,000 rows', value: '59\u00a0ms' },
        { label: 'Load a CSV, 1,000,000 rows', value: '0.44\u00a0s' },
        { label: 'Engine memory, 100,000 rows', value: '19.2 MiB' },
        { label: 'Engine memory, 1,000,000 rows', value: '199 MiB' },
        ...(engineKiB ? [{ label: 'Engine module, brotli', value: `about ${engineKiB} KiB` }] : []),
      ]}
    >
      Apple M4 Pro, median of nine runs, 14 November 2026, the loads 16 November.{' '}
      <a href={url('docs/guides/performance/')}>Method, all figures and the script to repeat it.</a>
    </BarCompare>
  </Split>

  <Split
    index="03"
    eyebrow="Accessibility"
    title="A table where a table is meant."
    lead="The usual grid is one component for every case, built from divs and described through ARIA. opengrid has three elements because the cases differ: a native table for reading, a grid only where the reader works."
    note={`Every feature is operated from the keyboard, state changes go through one live region, and axe-core runs in ${axeSpecs} end-to-end specs. What that verifies and what is still open is written down.`}
    links={[{ label: 'Accessibility, without rounding up', href: url('docs/guides/accessibility/') }]}
  >
    <div class="stack">
      <img
        class="screenshot"
        src={url('screens/grid-grouping.webp')}
        width="1632"
        height="1122"
        loading="lazy"
        alt="opengrid-grid from the live demo, grouped by country: a toolbar with + Filter, + Group and the density switch, a filter row, and one row per country with its row count and sums of quantity and amount."
      />
      <ElementList
        items={[
          { term: '<opengrid-table>', body: 'The answer is **read**: a native table, ordinary copy and paste, browser find.' },
          { term: '<opengrid-grid>', body: 'The answer is **worked with**: selection, editing, filtering, sorting, virtualization or paging.' },
          { term: '<opengrid-pivot>', body: 'Rows **crossed** with up to two column dimensions, with subtotals.' },
        ]}
      />
    </div>
  </Split>

  <Split
    index="04"
    reverse
    numbered
    eyebrow="Security"
    title="The browser never sends SQL."
    lead="A query is a JSON document with a fixed shape, not a string a backend has to parse or interpolate. The server is a library in your own program, which decides who is let in. There is nothing to inject into."
    points={[
      '**A source by name.** The token stands for a tenant; its row filter is attached to every query and cannot be switched off.',
      '**Only allowed fields.** A field outside the list does not exist for that client: the answer is the same error as a typo.',
      '**Operators, not expressions.** Checked before anything reaches the database.',
    ]}
    links={[{ label: 'The protocol', href: url('docs/protocol/') }]}
  >
    <CodeBlock
      code={query}
      lang="json"
      title="POST /query"
      label="JSON"
      marks={[
        { line: 2, n: 1 },
        { line: 3, n: 2 },
        { line: 7, n: 3 },
      ]}
    />
  </Split>

  <Showcase
    eyebrow="MCP Apps"
    title="The same grid, next to an AI assistant."
    lead="In chat clients with MCP Apps the grid opens beside the conversation. The reader keeps the keyboard, the assistant sets filter, sort and grouping of the same view through tools, and a field you left out is refused by name."
    link={{ label: 'The MCP adapter', href: url('docs/guides/mcp/') }}
  >
    <video
      controls
      preload="none"
      playsinline
      width="1920"
      height="1080"
      poster={url('videos/opengrid-mcp-poster.webp')}
      aria-label="Five requests to opengrid through MCP, as a chat with tool calls and the grid beside it"
    >
      <source src={url('videos/opengrid-mcp.mp4')} type="video/mp4" />
    </video>
  </Showcase>

  <Compare
    title="Next to a grid written in JavaScript"
    lead="The differences in one table. Each row is explained, with its price, in the documentation."
    columns={['A grid with its logic in JavaScript', 'opengrid']}
    rows={[
      { topic: 'Sorting, filtering, grouping', other: 'In the component, on the main thread', own: 'In an engine written in Rust, compiled to WebAssembly, in a worker if you like' },
      { topic: 'Data too big for the browser', other: 'A server mode: your backend answers, and you write the rules again', own: 'The same engine inside opengrid-server, or the query split between server and tab' },
      { topic: 'What "the same result" means', other: 'Whatever the two implementations happen to do with NULL, text order or decimals', own: 'Written down as rules and pinned by case files every path has to pass' },
      { topic: 'Text in a language', other: "Often the browser's collation on one side and the database's on the other", own: 'A locale in the query ("collation": "de"): one order from the engine, SQLite and PostgreSQL for Latin, Greek and Cyrillic text' },
      { topic: 'What goes over the wire', other: 'Often filter expressions or parameters your backend turns into SQL', own: 'A query as a JSON document, checked against the fields and rows the token may see' },
      { topic: 'Markup', other: 'Usually nested divs with ARIA roles for every kind of table', own: 'A native <table> where the data is read, role="grid" only where it is worked with' },
      { topic: 'Framework', other: 'A wrapper per framework, or one framework only', own: 'Web Components, with thin components for React, Vue and Svelte' },
      { topic: 'Pivot, grouping, export, tree', other: 'Often part of a paid edition', own: 'In the one package, under MIT or Apache-2.0' },
    ]}
    link={{ label: 'What sets it apart, in full', href: url('docs/what-sets-it-apart/') }}
  />

  <AudienceList
    heading="Who it is for"
    items={[
      {
        title: 'Apps that live on tables',
        body: 'Admin areas, reporting, internal tools: sorting, filtering, grouping, editing, a pivot with subtotals, trees and export, all in one package.',
      },
      {
        title: 'Any front end',
        body: 'The elements are Web Components. React, Vue and Svelte get components from the same package; Angular, Astro and plain HTML use them directly.',
      },
      {
        title: 'Readers with a keyboard or a screen reader',
        body: 'A native table where reading is enough and a grid where interaction needs one, operated from the keyboard and tested with axe in every state.',
      },
      {
        title: 'Data too big for the browser',
        body: 'Keep the data on your server: the browser sends a query object, never SQL, and the server enforces tokens, a row filter per tenant and the fields a client may see.',
      },
    ]}
  />

  <Tradeoffs
    eyebrow="The price"
    title="What you give up"
    lead="This design has a price, and it is better read here than found later."
    items={[
      'The engine is a WebAssembly module the page has to load. A table of fifty rows does not need it.',
      'There is no expression language: a column is stored or derived from a date part, never calculated in the grid.',
      'A pivot has hard limits and answers with an error over them, never with a truncated result.',
      'It is pre-1.0. The API is written down and tested, and may still change.',
    ]}
  />

  <section class="data" aria-labelledby="data-heading">
    <h2 id="data-heading">Where your data lives</h2>
    <p class="lead">
      A large table reaches a reader in one of two ways: the page loads it and the browser does the
      work, or it stays in your database and the grid asks for the part on screen. A third way
      splits a query between the two. Which one fits depends on the data, not on the grid: the
      element, its queries and its answers stay the same.
    </p>

    <div class="compare" role="region" aria-labelledby="compare-caption" tabindex="0">
      <table>
        <caption id="compare-caption">The three ways, side by side</caption>
        <thead>
          <tr>
            <td></td>
            <th scope="col">In the tab</th>
            <th scope="col">On the server</th>
            <th scope="col">Split</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">How</th>
            <td>The page loads the rows once. The engine, WebAssembly in a worker, answers every sort, filter and grouping in the browser.</td>
            <td>The grid asks for the rows it shows, 40 at a time while the reader scrolls. Your database filters, sorts, groups and counts.</td>
            <td>The planner gives the source the part it can answer and finishes the rest in the tab.</td>
          </tr>
          <tr>
            <th scope="row">First load</th>
            <td>The whole table: 0.44 s and 173 MiB in the engine for a million rows.</td>
            <td>One window, about 3.3 KiB, whatever the table's size.</td>
            <td>What the source sends for its part.</td>
          </tr>
          <tr>
            <th scope="row">Each interaction</th>
            <td>No round trip: a filter over a million rows takes 15 ms.</td>
            <td>One request per window: 13 to 80 ms over a million rows in PostgreSQL, plus the network.</td>
            <td>The source's time plus the tab's.</td>
          </tr>
          <tr>
            <th scope="row">Freshness</th>
            <td>A snapshot from when the page loaded it. The page loads again to see changes.</td>
            <td>Every window is read from the current data. The server can tell the grid that a source changed, and the reader refreshes in place.</td>
            <td>As current as the source.</td>
          </tr>
          <tr>
            <th scope="row">Editing</th>
            <td colspan="3">The same in all three: the grid edits, the page saves each change to its own API and tells the grid whether it was stored.</td>
          </tr>
          <tr>
            <th scope="row">Who sees what</th>
            <td>Every row the page loaded is in the browser.</td>
            <td>Only the fields a token may see, and only its tenant's rows: the server adds that filter to every query.</td>
            <td>As on the server.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="choose">
      <div>
        <h3>Start in the tab</h3>
        <p>
          It needs no server, and every interaction stays in the browser. Move the data to the
          server when one of these is true:
        </p>
        <ul>
          <li>The table is more than a browser should hold. A million rows take 173 MiB in the engine, and every reader's device pays for it.</li>
          <li>The data changes while people look at it, or several people edit it.</li>
          <li>Not every reader may see every row or field.</li>
        </ul>
        <p>
          Switching is a change of provider, not of the page.{' '}
          {conformanceCases} conformance cases check that the tab, the server and the split give
          the same answer.
        </p>
      </div>
      <div>
        <h3>No SQL from the browser</h3>
        <p>
          The grid sends a query object. The server checks it against the token and turns it into
          SQL with parameters; a field the token may not see does not exist for the client.
        </p>
        <CodeBlock code={windowQuery} lang="json" title="POST /query/orders" label="JSON" />
      </div>
    </div>

    <Diagram name="window-from-server" format="svg" narrow={{ width: 576, height: 740 }} />

    <h3>Where the rows can come from</h3>
    <ul class="sources">
      <li><strong>PostgreSQL</strong>: windows, groupings, a pivot as one statement, an export read through a cursor.</li>
      <li><strong>SQLite</strong>: a file, nothing to install; SQLite is compiled into the server.</li>
      <li><strong>A table in memory</strong>: a CSV file the server loads.</li>
      <li><strong>A connector of your own</strong>: a Rust trait of three methods; a source that only hands out rows gets filtering, sorting and grouping from the engine.</li>
      <li><strong>A server in another language</strong>: .NET, Java, Node or anything that speaks the HTTP protocol, proven with the same conformance cases.</li>
    </ul>

    <Facts
      layout="list"
      label="Measured: opengrid-server with PostgreSQL and SQLite"
      items={[
        { label: 'First window, 1,000,000 rows, PostgreSQL', value: '13 ms' },
        { label: 'Filtered and sorted window, 1,000,000 rows, PostgreSQL', value: '48 ms' },
        { label: 'Filtered and sorted window, 10,000,000 rows, SQLite', value: '16 ms' },
        { label: 'Grouping, 10,000,000 rows, PostgreSQL', value: '0.9 s' },
        { label: 'One window on the wire', value: '3.3 KiB' },
        { label: 'Server memory, 10,000,000 rows', value: 'under 20 MiB' },
      ]}
    />
    <p class="measured">
      Apple M4 Pro, server and database on one machine, so no network in the figures; indexes on
      the key and on the filtered columns; median of nine runs, 16 November 2026.{' '}
      <a href={url('docs/guides/performance/#in-server-mode')}>Method, all figures and what decides them.</a>
    </p>

    <div class="links">
      <Button href={url('docs/guides/where-queries-run/')} variant="secondary">Where queries run</Button>
      <Button href={url('docs/guides/connectors/')} variant="secondary">Connectors</Button>
      <Button href={url('docs/guides/saving-edits/')} variant="secondary">Saving edits</Button>
      <Button href={url('docs/api/#a-source-that-changes')} variant="quiet">A source that changes →</Button>
    </div>
  </section>

  <Quickstart
    lead="Install the package, put an element on the page and connect it to a provider. The documentation walks through the engine in the tab, bundlers and the React, Vue and Svelte components."
    steps={[
      'Install <code>@casoon/opengrid</code> with the line above.',
      'Put an <code>&lt;opengrid-table&gt;</code>, <code>&lt;opengrid-grid&gt;</code> or <code>&lt;opengrid-pivot&gt;</code> on the page.',
      'Connect it to a provider: the engine in the tab, or your server as below.',
    ]}
  >
    <CodeBlock code={page} lang="html" title="index.html" label="HTML" />
  </Quickstart>

  <CallToAction
    title="A grid on your page in three steps."
    href={url('docs/getting-started/quickstart/')}
    label="Read the quickstart"
  />
</Base>

<style>
  .screenshot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  /* The note under the measured figures: small, quiet, and on the 8 px grid. */
  .measured {
    margin: 16px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .measured a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .data {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  .data h3 {
    margin: 0 0 8px;
    color: var(--heading);
    font-size: 20px;
    font-weight: 600;
  }
  .data p,
  .data li {
    font-size: 15.5px;
    text-wrap: pretty;
  }
  .lead {
    max-width: 72ch;
    margin: 0 0 24px;
  }
  /* The comparison scrolls sideways on its own at phone width, never the page. */
  .compare {
    overflow-x: auto;
    margin: 0 0 40px;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .compare:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .compare table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 14.5px;
    line-height: 1.5;
  }
  .compare caption {
    padding: 12px 16px 0;
    text-align: start;
    color: var(--muted);
    font-size: 14px;
  }
  .compare th,
  .compare td {
    padding: 12px 16px;
    text-align: start;
    vertical-align: top;
    border-top: 1px solid var(--border);
  }
  .compare thead th,
  .compare thead td {
    border-top: 0;
  }
  .compare thead th {
    color: var(--heading);
    font-weight: 600;
  }
  .compare tbody th {
    width: 9rem;
    color: var(--heading);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .compare table {
      min-width: 600px;
    }
    .compare tbody th {
      width: 6rem;
    }
  }
  .choose {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 32px 48px;
    margin: 0 0 16px;
  }
  .choose p {
    margin: 0 0 16px;
  }
  .choose ul,
  .sources {
    margin: 0 0 16px;
    padding-inline-start: 1.25rem;
  }
  .choose li,
  .sources li {
    margin: 0 0 8px;
  }
  .sources {
    margin-bottom: 32px;
  }
  .data .links {
    margin-top: 32px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
