---
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { url } from '@casoon/pages-theme/url';
import Diagram from '../components/Diagram.astro';

// From README.md ("Data from a server"): a grid whose queries an opengrid-server answers.
const page = `<opengrid-grid label="Orders" datasource="orders"
               columns="id,customer,amount"></opengrid-grid>
<script type="module">
  import { connect, createRestProvider } from "@casoon/opengrid";
  connect(document.querySelector("opengrid-grid"), {
    provider: createRestProvider({ url: "https://example.org", source: "orders", token: "…" }),
  });
</script>`;
---

<Base>
  <Hero
    title="Grid, table and pivot on one query engine."
    lead="opengrid gives your web page three Web Components for showing and working with tabular data: a data grid, a table and a pivot. Sorting, filtering, grouping and pivots are answered by one engine: in the browser as WebAssembly, on your server against PostgreSQL, or split between the two, and the answer is the same everywhere."
  >
    <Install
      commands={[
        { label: 'npm', command: 'npm install @casoon/opengrid' },
        { label: 'pnpm', command: 'pnpm add @casoon/opengrid' },
      ]}
    />
    <Badges>
      <Badge>MIT OR Apache-2.0</Badge>
      <Badge>npm {config.version}</Badge>
      <Badge>React · Vue · Svelte · plain HTML</Badge>
    </Badges>
    <img
      slot="output"
      class="screenshot"
      src={url('screens/grid-overview.webp')}
      width="1672"
      height="1122"
      alt="opengrid-grid in the Base look, from the live demo: a search field with + Filter, + Group, Filter row, Columns and the density switch, a filter row, and orders sorted by ID with order date, customer, country, category and product. The footer reads 5000 matches and worker · wasm · 1 query."
    />
  </Hero>

  <Features
    heading="Who it is for"
    items={[
      {
        title: 'Apps that live on tables',
        body: 'Admin areas, reporting, internal tools: anywhere people sort, filter, group and edit rows, or cross them in a pivot with subtotals.',
      },
      {
        title: 'Any front end',
        body: 'The elements are Web Components. React, Vue and Svelte get components from the same package; Angular, Astro and plain HTML use them directly.',
      },
      {
        title: 'Readers with a keyboard or a screen reader',
        body: 'A native table where reading is enough and a grid where interaction needs one, operated from the keyboard and tested with axe in every state.',
      },
      {
        title: 'Data too big for the browser',
        body: 'Keep the data on your server: the browser sends a query object, never SQL, and the server enforces tokens, a row filter per tenant and the fields a client may see.',
      },
    ]}
  />

  <Facts
    items={[
      { value: '3', label: 'elements: table, grid and pivot' },
      { value: '3', label: 'places a query can run: tab, server, or both' },
      { value: '5', label: 'built-in looks, from Base to Dark' },
      { value: '5', label: 'live demo sites: JavaScript, React, Vue, Svelte, Angular' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <div class="text">
      <p>
        An element never runs a query itself. It hands the query, as JSON, to a provider you
        choose. The engine can answer it right in the tab, compiled to WebAssembly and running in
        a worker if you like, so data the page loads itself needs no server at all.
      </p>
      <p>
        For data that belongs on a server, <code>opengrid-server</code> answers the same queries
        from PostgreSQL, SQLite or a connector of your own. In between, the planner gives the
        server the part it can answer and finishes the rest in the tab. A shared set of
        conformance cases checks that all paths agree.
      </p>
    </div>
    <Diagram name="where-queries-run" format="svg" narrow={{ width: 560, height: 720 }} />
    <div class="links">
      <Button href={url('docs/guides/where-queries-run/')} variant="secondary">Where queries run</Button>
      <Button href={url('docs/guides/query-semantics/')} variant="secondary">Query semantics</Button>
      <Button href={url('demo/')} variant="secondary">Try the demo</Button>
      <Button href="https://og-vanilla.casoon.dev/" variant="quiet">All live demos →</Button>
    </div>
  </section>

  <Quickstart
    lead="Install the package, put an element on the page and connect it to a provider. The documentation walks through the engine in the tab, bundlers and the React, Vue and Svelte components."
    steps={[
      'Install <code>@casoon/opengrid</code> with the line above.',
      'Put an <code>&lt;opengrid-table&gt;</code>, <code>&lt;opengrid-grid&gt;</code> or <code>&lt;opengrid-pivot&gt;</code> on the page.',
      'Connect it to a provider: the engine in the tab, or your server as below.',
    ]}
  >
    <CodeBlock code={page} lang="html" title="index.html" label="HTML" />
  </Quickstart>
</Base>

<style>
  .screenshot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
</style>
