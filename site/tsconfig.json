{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  // vendor/ is the synced theme; it is checked where it is developed (gh-pages-template).
  // public/opengrid/ is the wasm-bindgen output copied in by scripts/demo-assets.mjs.
  "exclude": ["dist", "vendor", "public/opengrid"]
}
